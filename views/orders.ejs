<%- include('partials/header') %>
<h1>My Orders</h1>
<% if (orders.length === 0) { %>
  <p>You have no orders yet.</p>
<% } else { %>
  <table class="list">
    <thead><tr><th>#</th><th>Date</th><th>Total</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% orders.forEach(function (o) { %>
        <tr>
          <td><%= o.id %></td>
          <td><%= o.created_at %></td>
          <td>$<%= Number(o.total).toFixed(2) %></td>
          <td><%= o.status %></td>
          <td><a href="/orders/<%= o.id %>">View</a></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  <p class="hint">IDOR Test: open <code>/orders/1</code>, <code>/orders/2</code>...
    even if they belong to another user.</p>
<% } %>
<%- include('partials/footer') %>
