<%- include('partials/header') %>
<div class="profile">
  <h1>Perfil de <%= profile.username %></h1>
  <table class="kv">
    <tr><th>ID</th><td><%= profile.id %></td></tr>
    <tr><th>Nombre</th><td><%= profile.full_name %></td></tr>
    <tr><th>Email</th><td><%= profile.email %></td></tr>
    <tr><th>Rol</th><td><%= profile.role %></td></tr>
    <tr><th>Direccion</th><td><%= profile.address %></td></tr>
    <!-- [VULN-A02] dato sensible expuesto en texto plano -->
    <tr><th>Tarjeta</th><td><%= profile.credit_card %></td></tr>
  </table>

  <h2>Foto de perfil</h2>
  <form action="/profile/avatar" method="POST" enctype="multipart/form-data">
    <input type="file" name="avatar">
    <button type="submit">Subir</button>
  </form>

  <p class="hint">Prueba IDOR: cambia el numero en la URL
    <code>/profile/1</code>, <code>/profile/2</code>, ...</p>
</div>
<%- include('partials/footer') %>
