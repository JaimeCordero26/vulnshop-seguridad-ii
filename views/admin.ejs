<%- include('partials/header') %>
<h1>Administration Dashboard</h1>
<p class="hint">This page should enforce the <code>admin</code> role, but only checks for general authentication (Broken Access Control - Vertical Privilege Escalation).</p>

<h2>Registered Users</h2>
<table class="list">
  <thead><tr><th>ID</th><th>Username</th><th>Email</th><th>Role</th><th>Address</th><th>Credit Card</th></tr></thead>
  <tbody>
    <% users.forEach(function (u) { %>
      <tr>
        <td><%= u.id %></td>
        <td><%= u.username %></td>
        <td><%= u.email %></td>
        <td><%= u.role %></td>
        <td><%= u.address %></td>
        <td class="mono"><%= u.credit_card %></td>
      </tr>
    <% }); %>
  </tbody>
</table>

<h2>Import Image from URL</h2>
<p class="hint">Fetches a URL server-side without validation (SSRF: test
  <code>http://localhost:3000/admin</code> or <code>http://127.0.0.1:3000/</code>).</p>
<form action="/admin/import-image" method="POST">
  <input type="text" name="url" placeholder="http://127.0.0.1:3000/" size="50">
  <button type="submit">Fetch</button>
</form>
<% if (error) { %><p class="error"><%= error %></p><% } %>
<% if (fetched) { %>
  <h3>Server Response:</h3>
  <pre class="fetched"><%= fetched %></pre>
<% } %>

<%- include('partials/footer') %>
