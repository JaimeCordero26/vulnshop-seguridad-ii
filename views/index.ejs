<%- include('partials/header') %>

<% if (query !== null) { %>
  <!-- SEARCH RESULTS VIEW -->
  <div class="section-header">
    <h1 class="section-title">Search results for "<%= query %>"</h1>
    <a href="/" class="hint">&larr; Back to full catalog</a>
  </div>
<% } else { %>
  <!-- 3D CINEMATIC HERO (ROLODEX CUBE) -->
  <section class="hero-cinematic">
    <div class="hero-watermark">HARDWARE</div>
    
    <div class="hero-content">
      <span class="hero-tag">NEXT-GEN HARDWARE ARCHITECTURE</span>
      <h1 class="hero-title">PRECISION GEAR.<br>BRUTAL PERFORMANCE.</h1>
      <p class="hero-subtitle">
        High-performance equipment for software developers, security researchers, and gamers.
      </p>

      <!-- 3D Rolodex Cube -->
      <div class="cube-scene">
        <div class="cube-wrapper">
          <div class="cube-face face-front">
            <img src="https://images.unsplash.com/photo-1618384887929-16ec33fab9ef?auto=format&fit=crop&w=600&q=80" alt="Mechanical Keyboard">
            <div class="cube-face-label">01 // MECHANICAL RGB</div>
          </div>
          <div class="cube-face face-bottom">
            <img src="https://images.unsplash.com/photo-1527864550417-7fd91fc51a46?auto=format&fit=crop&w=600&q=80" alt="Gaming Mouse">
            <div class="cube-face-label">02 // 16000 DPI OPTICAL</div>
          </div>
          <div class="cube-face face-back">
            <img src="https://images.unsplash.com/photo-1547119957-637f8679db1e?auto=format&fit=crop&w=600&q=80" alt="144Hz Monitor">
            <div class="cube-face-label">03 // 144HZ IPS PANEL</div>
          </div>
          <div class="cube-face face-top">
            <img src="https://images.unsplash.com/photo-1597872200969-2b65d56bd16b?auto=format&fit=crop&w=600&q=80" alt="NVMe SSD">
            <div class="cube-face-label">04 // NVME GEN3 SPEED</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- GLASSMORPHISM SETUP CALCULATOR -->
  <div class="calculator-box">
    <div class="calculator-header">
      <div>
        <h3 class="calculator-title">⚡ Setup Estimator</h3>
        <p class="hint">Calculate an interactive estimate based on the hardware modules you require</p>
      </div>
      <div class="calculator-price" id="calcPriceDisplay">$375.00</div>
    </div>
    <input type="range" min="1" max="8" value="3" class="calc-slider" id="budgetSlider" oninput="updateBudget(this.value)">
  </div>
  <script>
    function updateBudget(val) {
      document.getElementById('calcPriceDisplay').textContent = '$' + (val * 125).toFixed(2);
    }
  </script>

  <!-- CATALOG SECTION HEADER (10vw tracking-tighter) -->
  <div class="catalog-section-head">
    <div class="catalog-big-title">01 // CATALOG</div>
    <div class="catalog-meta-bar">
      <span>HIGH-END HARDWARE ARCHIVE</span>
      <span>[ <%= products.length %> ITEMS IN STOCK ]</span>
    </div>
  </div>
<% } %>

<% if (products.length === 0) { %>
  <p class="hint" style="text-align: center; margin: 4rem 0;">No products found matching your search.</p>
<% } else { %>
  <!-- CATALOG GRID -->
  <div class="grid">
    <% products.forEach(function (p, index) { %>
      <div class="card">
        <div class="card-mac-bar">
          <div class="mac-dots-wrap">
            <span class="mac-dot dot-red"></span>
            <span class="mac-dot dot-yellow"></span>
            <span class="mac-dot dot-green"></span>
          </div>
          <span class="card-mac-title">ITEM_0<%= index + 1 %>.SYS</span>
          <span class="card-mac-tag">IN_STOCK</span>
        </div>

        <div class="card-img-wrap">
          <a href="/product/<%= p.id %>">
            <img src="<%= p.image_url %>" alt="<%= p.name %>" loading="lazy">
          </a>
        </div>

        <div class="card-body">
          <h3><a href="/product/<%= p.id %>"><%= p.name %></a></h3>
          <p class="hint"><%= p.description %></p>
        </div>

        <div class="card-footer">
          <span class="price">$<%= Number(p.price).toFixed(2) %></span>
          <span class="stock-badge">Stock: <%= p.stock %></span>
        </div>

        <form action="/cart/add" method="POST">
          <input type="hidden" name="product_id" value="<%= p.id %>">
          <button type="submit" class="btn-block">Add to Cart</button>
        </form>
      </div>
    <% }); %>
  </div>
<% } %>

<%- include('partials/footer') %>
