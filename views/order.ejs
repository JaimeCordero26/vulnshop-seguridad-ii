<%- include('partials/header') %>
<p><a href="/orders">&larr; My Orders</a></p>
<h1>Order #<%= order.id %></h1>
<p>Owner (user_id): <%= order.user_id %></p>
<p>Date: <%= order.created_at %> · Status: <%= order.status %></p>
<table class="list">
  <thead><tr><th>Product</th><th>Price</th></tr></thead>
  <tbody>
    <% order.items.forEach(function (i) { %>
      <tr><td><%= i.name %></td><td>$<%= Number(i.price).toFixed(2) %></td></tr>
    <% }); %>
  </tbody>
  <tfoot><tr><th>Total</th><th>$<%= Number(order.total).toFixed(2) %></th></tr></tfoot>
</table>
<%- include('partials/footer') %>
